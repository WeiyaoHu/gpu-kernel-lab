{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CUDA: Build current file",
      "type": "process",
      "command": "cmd.exe",
      "args": [
        "/d",
        "/c",
        "${workspaceFolder}\\.vscode\\cuda_task.cmd",
        "build",
        "${fileBasename}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "CUDA: Build and run current file",
      "type": "process",
      "command": "cmd.exe",
      "args": [
        "/d",
        "/c",
        "${workspaceFolder}\\.vscode\\cuda_task.cmd",
        "run",
        "${fileBasename}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$msCompile"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
